# Copy to .env and adjust as needed. Never commit .env.

# --- Postgres (local Docker) ---
POSTGRES_USER=asl
POSTGRES_PASSWORD=asl_dev_only
POSTGRES_DB=asl_pilot
POSTGRES_PORT=5432
DATABASE_URL=postgres://asl:asl_dev_only@localhost:5432/asl_pilot

# --- Adminer (optional DB UI) ---
# 8088 avoids the crowded 8080 port that webpack/jenkins/spring/etc. all want.
ADMINER_PORT=8088

# --- Frontend dev mode ---
# When VITE_DEV_MODE=1, the build is treated as a dev build (used for legacy
# checks; prefer VITE_DEV_TOOLS for new dev-only UI). Always 0 in production
# builds. Consumed by Vite (host process), not by Compose.
VITE_DEV_MODE=1

# Show dev affordances in the UI (Skip-login, dev panels, force-state toolboxes).
# Set to '0' to hide all dev UI (useful for previewing the real user experience).
VITE_DEV_TOOLS=1

# --- Backend ---
# Consumed by the Node/Hono backend (host process), not by Compose.
BACKEND_PORT=3000
SESSION_SECRET=local-dev-only-change-for-prod

# Backend dev affordances. When '0', POST /api/auth/dev-login returns 404.
# MUST be set to 0 in production deploys so the dev-bypass endpoint is unreachable.
DEV_TOOLS_ENABLED=1

# --- ML model (v2) ---
# Path to the deployed ONNX model bundle (relative to /public).
# Until the ML team ships a real model, this points to nothing and the CV path is mocked.
# Consumed by Vite (host process), not by Compose.
VITE_MODEL_BUNDLE_URL=/models/asl-stub.json
