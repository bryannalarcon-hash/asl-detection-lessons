# Heavy runtime assets live on a mounted volume in prod (ASSETS_DIR), seeded
# separately — keep them out of the image. The tiny gloss_to_idx.json stays as
# an in-image fallback. configs/, scripts/*.ts, backend/, frontend/ are kept.
frontend/public/models/*.onnx
frontend/public/models/fp16
frontend/public/videos
