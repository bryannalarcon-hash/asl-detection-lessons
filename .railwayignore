# Upload filter for `railway up --no-gitignore`. We pass --no-gitignore so the
# gitignored runtime assets the app SERVES (frontend/public/videos + /models)
# get uploaded — this list re-excludes the heavy non-app dirs that .gitignore
# would otherwise have removed.
node_modules
**/node_modules
**/dist
.git

# Huge non-app artifacts (model checkpoints, datasets, venvs)
results
data
.venv-demo
.venv
*.zip
*.pdf
*.tgz
ruvector.db

# Python CV training code + infra (not part of the web app)
src
modal_apps
tools
playground
scripts/*.py
scripts/*.sh

# Docs / dev artifacts not needed at runtime
docs
design
costs
logs
screenshots
test-results
tests
.scaffold-*-report.md
*.log

# Large assets that blow the upload limit (hosted/handled separately):
#  - lesson videos (578MB) -> reference video falls back to the mock on prod
#  - fp16 model set (33MB, unused by default; app loads the fp32 .onnx)
frontend/public/videos
frontend/public/models/fp16

# KEPT: frontend/public/models/*.onnx (fp32, ~93MB) + gloss_to_idx.json,
# configs/, scripts/*.ts, backend/, frontend/ — needed to build + serve.
